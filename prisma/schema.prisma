generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hunter {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  slug        String
  avatarUrl   String?
  kycVerified Boolean    @default(false)
  points      Int        @default(0)
  rank        Int?
  nbReports   Int        @default(0)
  nationality String?
  firstName   String?
  lastName    String?
  website     String?
  github      String?
  twitter     String?
  addedAt     DateTime   @default(now())
  lastSeenAt  DateTime?
  activities  Activity[]
}

model Activity {
  id                 Int      @id @default(autoincrement())
  hunterId           Int
  date               DateTime
  bugTypeName        String
  bugTypeSlug        String
  bugTypeDescription String?
  bugTypeLink        String?
  workflowState      String
  // v2 hacktivity items carry no report id or time, so same-day reports of
  // the same bug type and state are only distinguishable by their position:
  // ordinal 1..N within the (hunter, date, bugType, state) group.
  ordinal            Int      @default(1)
  isNew              Boolean  @default(true)
  crawledAt          DateTime @default(now())
  hunter             Hunter   @relation(fields: [hunterId], references: [id], onDelete: Cascade)

  @@unique([hunterId, date, bugTypeSlug, workflowState, ordinal])
}

model PollLog {
  id             Int       @id @default(autoincrement())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  newActivities  Int       @default(0)
  status         String    @default("running")
  error          String?
}
